{
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/admin",
      "destination": "/admin.html"
    },
    {
      "source": "/admin/",
      "destination": "/admin.html"
    },
    {
      "source": "/shatabdi-poster-bg.png",
      "destination": "/shatabdi-poster-bg.png"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}